{
  "name": "zeta-cons-pokhara",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --host --port 8082",
    "dev:server": "nodemon app.js",
    "start": "node app.js",
    "build": "echo 'Using pre-built React frontend assets'",
    "build:local": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0"
  },
  "main": "app.js",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "nodemon": "^3.1.14",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
